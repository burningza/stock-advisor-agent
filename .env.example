# Copy this to .env and fill in your values

# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-key-here

# Model to use (any OpenRouter model ID)
# STOCK_MODEL=openai/gpt-4o
# STOCK_MODEL=anthropic/claude-sonnet-4
# STOCK_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
STOCK_MODEL=openai/gpt-4o
